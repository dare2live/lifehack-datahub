    "ln_admission_plan": {
      "name": "辽宁招生计划",
      "kind": "controlled_manual_export",
      "owner": "lifehack-datahub",
      "raw_glob": "raw/ln_admission_plan/**/*.xlsx",
      "remote_files": [],
      "acquisition": {
        "status": "manual_required",
        "official_distribution": "网报志愿系统和《辽宁招生考试》杂志",
        "evidence_urls": [
          "https://jyt.ln.gov.cn/jyt/jyzx/jyyw/2025062010482638109/index.shtml"
        ],
        "notes": "辽宁官方说明完整招生计划在志愿填报系统和杂志公布；辽宁招生考试之窗公开站点主要发布计划更正和征集剩余计划。DataHub 只接收从官方系统/杂志导出的清洗文件并生成标准数据包。"
      },
      "target_tables": ["fa_dim_ln_admission_plan"]
    },
    "ln_application_workbook": {
      "name": "辽宁本地报考工作簿",
      "kind": "controlled_manual_cleaned_workbook",
      "owner": "lifehack-datahub",
      "raw_glob": "raw/ln_application_workbook/**/*.xlsx",
      "remote_files": [],
      "acquisition": {
        "status": "manual_required",
        "official_distribution": "本地已清洗报考工作簿；上游应追溯到网报志愿系统和《辽宁招生考试》杂志",
        "evidence_urls": [
          "https://jyt.ln.gov.cn/jyt/jyzx/jyyw/2025062010482638109/index.shtml"
        ],
        "notes": "多 sheet 工作簿可同时产出招生计划与历史分数/位次 cleaned CSV。Excel 原文件只进入 raw intake manifest，不进入 Git；解析规则维护在 config/ln_application_workbook.json。"
      },
      "target_tables": ["fa_dim_ln_admission_plan", "fa_fact_ln_score_history"]
    },
    "ln_score_history": {
      "name": "辽宁历史分数线",
