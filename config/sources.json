          }
        }
      ],
      "acquisition": {
        "status": "remote_configured",
        "official_distribution": "教育部全国高等学校名单",
        "evidence_urls": [
          "https://www.moe.gov.cn/jyb_xxgk/s5743/s5744/202506/t20250627_1195683.html"
        ],
        "notes": "用于生成 fa_dim_school_profile。教育部学校标识码不是辽宁招生计划本地院校代码，后续需用 fa_bridge_school_identity 对齐。"
      },
      "target_tables": ["fa_dim_school_profile"]
    },
    "school_outcome": {
      "name": "高校出口指标",
      "kind": "annual_report_metrics",
      "owner": "lifehack-datahub",
      "raw_glob": "raw/school_outcome/**/*",
      "remote_files": [],
      "acquisition": {
        "status": "source_collection_required",
        "official_distribution": "学校就业质量报告、升学质量报告、教育质量报告",
        "evidence_urls": [],
        "notes": "只采集可引用来源中的结构化指标，如升学率、就业落实率、深造率、保研率等；指标口径必须进入 metric_scope 和 evidence_quote。"
      },
      "target_tables": ["fa_fact_school_outcome"]
    },
    "major_outcome": {
      "name": "专业出口指标",
      "kind": "curated_outcome_metrics",
      "owner": "lifehack-datahub",
      "raw_glob": "raw/major_outcome/**/*",
      "remote_files": [],
      "acquisition": {
        "status": "source_collection_required",
        "official_distribution": "教育部目录、学校培养方案、就业质量报告、公开行业统计",
        "evidence_urls": [],
        "notes": "专业层数据优先保留有明确来源的就业方向、升学去向、考公适配、薪资或需求指标；没有来源的主观判断不得进入数据包。"
      },
      "target_tables": ["fa_fact_major_outcome"]
    },
    "policy_industry_map": {
