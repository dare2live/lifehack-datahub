      "remote_files": [],
      "acquisition": {
        "status": "curation_required",
        "official_distribution": "十三五/十四五规划原文、统计公报、行业协会和上市公司公开数据",
        "evidence_urls": [],
        "notes": "core 现有脚本中的历史兑现结论应迁出为 DataHub 可审计数据包；actual_outcome 与 outcome_score 必须由证据字段支撑。"
      },
      "target_tables": ["fa_dim_policy_plan_history"]
