      "acquisition": {
        "status": "partial_official_derivation_configured",
        "official_distribution": "2025 可由辽宁招生考试之窗投档最低分 + 成绩统计表派生；多年份完整来源仍需继续确认",
        "evidence_urls": [],
        "notes": "DataHub 已有 build-score-history-from-projection，可把官方投档最低分按一分一段累计人数派生为 min_rank。该 rank 是分数段累计位次，不是同分排序精确位次；2023/2024 成绩统计表仍需从官方图片页解析或人工复核。"
      },
      "target_tables": ["fa_fact_ln_score_history"]
    },
