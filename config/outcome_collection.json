{
  "version": "1",
  "updated_at": "2026-05-13",
  "notes": "学校/专业 outcome 采集任务配置。DataHub 只生成采集队列，不把无来源判断发布到 core。",
  "defaults": {
    "school_limit": 80,
    "major_limit": 80,
    "metric_year": 2025,
    "status": "todo"
  },
  "audit": {
    "pending_statuses": ["todo", "in_progress", "needs_review"],
    "complete_statuses": ["collected", "verified", "ready"],
    "blocked_statuses": ["blocked", "not_found", "not_applicable"],
    "required_evidence_columns": ["metric_value", "source_url", "evidence_quote"]
  },
  "review_batch": {
    "selection_statuses": ["todo", "in_progress", "needs_review"],
    "limit_per_domain": 20,
    "editable_columns": [
      "status",
      "metric_value",
      "source_title",
      "source_url",
      "evidence_quote",
      "metric_scope",
      "denominator",
      "source_date",
      "availability_date",
      "built_at",
      "notes"
    ]
  },
  "candidate_merge": {
    "approved_statuses": ["approved"],
    "target_status": "verified",
    "editable_columns": [
      "status",
      "metric_value",
      "source_title",
      "source_url",
      "evidence_quote",
      "metric_scope",
      "source_date",
      "availability_date",
      "built_at",
      "notes"
    ]
  },
  "report_source_plan": {
    "status": "todo",
    "limit_per_domain": 40,
    "report_scopes": {
      "school": [
        {
          "report_scope": "employment_quality_report",
          "query_templates": [
            "{entity_name} {metric_year} 毕业生就业质量报告 filetype:pdf",
            "{entity_name} {metric_year} 就业质量报告 PDF",
            "{entity_name} {metric_year} 届毕业生就业质量年度报告"
          ]
        },
        {
          "report_scope": "undergraduate_teaching_quality_report",
          "query_templates": [
            "{entity_name} {metric_year} 本科教学质量报告 就业",
            "{entity_name} {metric_year} 本科教学质量报告 PDF"
          ]
        }
      ],
      "major": [
        {
          "report_scope": "school_major_outcome_section",
          "query_templates": [
            "{entity_name} 专业 {metric_year} 就业质量报告",
            "{entity_name} 专业 就业去向 升学 考公",
            "{entity_name} 专业 本科教学质量报告 就业"
          ]
        }
      ]
    }
  },
  "domains": {
    "school": {
      "source_table": "fa_dim_ln_admission_plan",
      "entity_code_column": "school_code",
      "entity_name_column": "school_name",
      "filters": {
        "batch": ["本科批"],
        "subject_cat": ["物理类", "历史类"]
      },
      "metrics": ["postgrad_rate", "employment_rate", "keep_research_rate", "civil_service_rate"],
      "query_templates": [
        "{entity_name} {metric_year} 就业质量报告",
        "{entity_name} {metric_year} 毕业生就业质量报告 {metric_label}",
        "{entity_name} {metric_year} 本科教学质量报告 {metric_label}"
      ]
    },
    "major": {
      "source_table": "fa_dim_ln_admission_plan",
      "entity_code_column": "major_full",
      "entity_name_column": "major_full",
      "filters": {
        "batch": ["本科批"],
        "subject_cat": ["物理类", "历史类"]
      },
      "metrics": ["employment_rate", "postgrad_rate", "civil_service_fit_score", "exam_friendly_score"],
      "query_templates": [
        "{entity_name} 专业 {metric_year} 就业质量报告",
        "{entity_name} 专业 就业方向 {metric_label}",
        "{entity_name} 专业 考研 考公 {metric_label}"
      ]
    }
  }
}
