  "validity_checks": {
    "remote_file": ["url_accessible", "content_hash", "file_size", "mime_type", "source_date_present"],
    "web_api": ["endpoint_accessible", "status_code_ok", "response_schema", "quota_error_absent", "key_not_logged"],
    "manual_file": ["file_exists", "content_hash", "operator_recorded", "official_distribution_recorded"],
    "collection_plan": ["status_registered", "required_evidence_present", "value_parseable", "metric_registered"],
    "derived_mart": ["input_package_lineage_present", "row_count_nonzero", "score_profile_registered", "reason_codes_present"]
  },
  "validity_check_catalog": {
    "url_accessible": {
      "check_name": "URL 可访问",
      "check_scope": "remote_files 或 research_candidates",
      "expected_evidence": "HTTP 2xx/3xx、最终 URL、响应大小和采集时间",
      "block_on_fail": true,
      "remediation": "修正 URL、补 headers，或降级为 research_candidates 等待人工确认。"
    },
    "content_hash": {
      "check_name": "内容哈希",
      "check_scope": "raw 文件、远程附件或手工 intake 文件",
      "expected_evidence": "sha256 与配置或 manifest 一致",
      "block_on_fail": true,
      "remediation": "重新下载/重新 intake；若来源确实更新，先记录新快照再重跑解析。"
    },
    "file_size": {
      "check_name": "文件大小",
      "check_scope": "下载文件或手工文件",
      "expected_evidence": "文件大小大于 0 且与历史范围不异常",
      "block_on_fail": true,
      "remediation": "检查是否下载到错误页面、登录页或空文件。"
    },
    "mime_type": {
      "check_name": "文件类型",
      "check_scope": "下载文件响应头和文件后缀",
      "expected_evidence": "MIME/扩展名与 parser 预期一致",
      "block_on_fail": true,
      "remediation": "调整 parser、解压规则或把来源退回候选研究。"
    },
    "source_date_present": {
      "check_name": "来源日期",
      "check_scope": "来源配置、采集计划和 manifest",
      "expected_evidence": "source_date 与 availability_date 可追溯",
      "block_on_fail": true,
      "remediation": "补官方发布日期、报告年份或人工 intake 说明。"
    },
    "endpoint_accessible": {
      "check_name": "接口可访问",
      "check_scope": "Web API endpoint",
      "expected_evidence": "请求可达并记录响应时间",
      "block_on_fail": true,
      "remediation": "检查 endpoint、网络、配额和授权方式。"
    },
    "status_code_ok": {
      "check_name": "接口状态码",
      "check_scope": "Web API 响应",
      "expected_evidence": "HTTP 状态码和业务状态均为成功",
      "block_on_fail": true,
      "remediation": "按供应商错误码修正参数、频率或密钥。"
    },
    "response_schema": {
      "check_name": "响应结构",
      "check_scope": "Web API JSON",
      "expected_evidence": "必需字段存在且类型符合 parser 输入契约",
      "block_on_fail": true,
      "remediation": "更新 parser/schema，或在配置中锁定 API 版本。"
    },
    "quota_error_absent": {
      "check_name": "配额错误",
      "check_scope": "Web API 响应",
      "expected_evidence": "无限流、欠费、配额不足或权限错误",
      "block_on_fail": true,
      "remediation": "降低并发、延长间隔或暂停该来源。"
    },
    "key_not_logged": {
      "check_name": "密钥不落盘",
      "check_scope": "Web API 请求、manifest 和日志",
      "expected_evidence": "只记录 key_env，不记录 key 明文",
      "block_on_fail": true,
      "remediation": "清理输出并改为环境变量注入。"
    },
    "file_exists": {
      "check_name": "本地文件存在",
      "check_scope": "manual intake 输入文件",
      "expected_evidence": "文件路径存在且已复制到 ignored raw 区",
      "block_on_fail": true,
      "remediation": "重新执行 intake-manual，补采集人和来源说明。"
    },
    "operator_recorded": {
      "check_name": "采集人记录",
      "check_scope": "manual intake manifest",
      "expected_evidence": "operator/acquired_by 字段存在",
      "block_on_fail": true,
      "remediation": "补 intake manifest，不允许口头来源进入包。"
    },
    "official_distribution_recorded": {
      "check_name": "分发说明",
      "check_scope": "sources.json acquisition",
      "expected_evidence": "官方分发渠道、证据 URL 或来源说明存在",
      "block_on_fail": true,
      "remediation": "补官方说明；无法确认时保持 research_required。"
    },
    "status_registered": {
      "check_name": "状态受控",
      "check_scope": "collection/review plan",
      "expected_evidence": "状态值属于配置允许集合",
      "block_on_fail": true,
      "remediation": "把自由文本状态映射到配置状态。"
    },
    "required_evidence_present": {
      "check_name": "证据完整",
      "check_scope": "collection/review plan",
      "expected_evidence": "source_url、evidence_quote、source_date、availability_date 齐全",
      "block_on_fail": true,
      "remediation": "补证据摘录和来源日期，不能只填数值。"
    },
    "value_parseable": {
      "check_name": "数值可解析",
      "check_scope": "collection plan 指标值",
      "expected_evidence": "metric_value 可解析为指标注册表要求的类型",
      "block_on_fail": true,
      "remediation": "修正单位、百分比、区间值或文本值。"
    },
    "metric_registered": {
      "check_name": "指标已注册",
      "check_scope": "metric_key",
      "expected_evidence": "metric_key 存在于指标配置或 registry",
      "block_on_fail": true,
      "remediation": "先登记指标定义、单位、值域和解释口径。"
    },
    "input_package_lineage_present": {
      "check_name": "上游 lineage",
      "check_scope": "derived mart 输入包",
      "expected_evidence": "输入 package_id、manifest hash 和 source_date 可追溯",
      "block_on_fail": true,
      "remediation": "先导入或重建上游标准包。"
    },
    "row_count_nonzero": {
      "check_name": "输出非空",
      "check_scope": "derived mart 输出",
      "expected_evidence": "目标表行数大于 0 且通过质量报告",
      "block_on_fail": true,
      "remediation": "检查上游过滤条件、主键和评分配置。"
    },
    "score_profile_registered": {
      "check_name": "评分档案",
      "check_scope": "derived mart 配置",
      "expected_evidence": "score_profile、权重和阈值来自配置文件",
      "block_on_fail": true,
      "remediation": "补配置，不在 builder 里硬编码权重。"
    },
    "reason_codes_present": {
      "check_name": "原因码",
      "check_scope": "derived mart 输出",
      "expected_evidence": "reason_codes_json 和 signal_contribution_json 可解释",
      "block_on_fail": true,
      "remediation": "补分项贡献和 lineage，不输出黑箱分。"
    }
  },
  "state_management": {
    "snapshot_id_pattern": "{source_key}:{source_instance_key}:{partition_hash}:{content_hash}:{source_date}",
    "content_hash_scope": ["raw_file_bytes", "api_response_body", "normalized_candidate_row", "package_manifest"],
    "partition_state_fields": ["source_key", "source_instance_key", "target_table", "partition_key_json", "source_date", "availability_date", "content_hash"],
    "supersede_policy": "新快照不覆盖旧快照；发布层用 source_date/availability_date 和 promotion_status 选择当前版本。",
    "stale_policy": {
      "mark_stale_after_failed_health_checks": 2,
      "keep_last_good_package": true,
      "block_downstream_if_no_last_good_package": true
    },
    "delete_policy": {
      "allow_physical_delete": false,
      "require_reconciliation_plan": true,
      "require_delete_plan": true,
      "core_execute_requires_dry_run": true
    }
  },
  "source_health_policy": {
    "statuses": ["healthy", "degraded", "unavailable", "stale_source", "schema_changed", "hash_changed", "quota_limited", "manual_review_pending"],
    "health_record_required_for": ["skipped", "failed", "blocked", "stale_source", "quota_limited"],
    "schema_changed_action": "阻断标准包发布，先更新 parser/schema/quality report，再重新生成候选或数据包。",
    "hash_changed_action": "生成新 raw snapshot 和差异报告；官方远程文件 hash 变化不能静默覆盖配置。",
    "quota_limited_action": "暂停该 API 串行组，记录 health，保留上一次可用标准包。",
    "stale_source_action": "输出层降权或标注来源过期；不能用过期来源覆盖新分区。"
  },
  "scheduler": {
    "default_max_parallel": 3,
    "serial_groups": [
      "core_import",
      "delete_migration",
      "same_target_table",
      "core_admission_serial",
      "amap_api_limited"
    ],
    "parallel_groups": [
      "remote_probe",
      "manual_intake",
      "independent_collection_batch",
      "official_reference_parallel",
      "city_collection_parallel",
      "nonstandard_review",
      "derived_readonly_mart"
    ],
    "failure_policy": {
      "block_dependents_on_source_failure": true,
      "allow_independent_sources_to_continue": true,
      "require_health_record_for_skipped_source": true
    },
    "batching": {
      "dependency_gate": "phase_complete_without_blocking_failure",
      "serial_group_policy": "同一串行组按 step_order 单线程执行；core 导入、删除迁移、同目标表发布和高德 API 限流不得重叠。",
      "parallel_group_policy": "同阶段、无直接依赖、不同锁资源的来源可并发；某来源失败只阻断其下游，不阻断无依赖来源。",
      "target_table_locking": true,
      "same_target_table_policy": "同一目标表的 package 发布、core dry-run/execute 和 delete plan 串行；原始下载和候选抽取可在不同 raw 分区并行。",
      "max_parallel_by_group": {
        "remote_probe": 4,
        "manual_intake": 2,
        "independent_collection_batch": 3,
        "official_reference_parallel": 3,
        "city_collection_parallel": 3,
        "nonstandard_review": 2,
        "derived_readonly_mart": 3
      },
      "api_rate_limit_policy": {
        "amap_api_limited": "单 lane 串行执行，按 manifest 断点续跑；配额错误时整组暂停并写 health。"
      }
    }
  },
  "source_policies": {
