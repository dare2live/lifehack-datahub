{
  "version": "1",
  "updated_at": "2026-05-13",
  "notes": "数据更新治理配置。所有来源先做有效性检测和快照记录，再按配置选择全量替换、分区替换、主键 upsert、追加快照或人工复核晋级。非标数据不得直接进入 core。",
  "source_key": "data_update_governance",
  "target_tables": [
    "fa_meta_source_snapshot",
    "fa_meta_source_health",
    "fa_meta_update_run",
    "fa_meta_update_run_step",
    "fa_meta_nonstandard_review_queue"
  ],
  "update_modes": {
    "full_replace": "完整快照替换，适合官方目录、专业目录、行政区划等小中型维表。",
    "partition_replace": "按年份、批次、地区或快照日期替换，适合招生计划、分数线、城市指标。",
    "primary_key_upsert": "按主键更新和插入，适合复核后的增量事实。",
    "append_snapshot": "保留每次快照，适合租售价格、招聘、POI 和排名这类时间序列。",
    "manual_review_promote": "只生成候选和复核队列，人工批准后才发布标准包。",
    "derived_rebuild": "由已发布标准表重新计算 mart，输入未变时可跳过。"
  },
  "update_mode_runbook": {
    "full_replace": {
      "change_detection": "比较来源 hash、行数、schema 和 source_date；无变化时跳过发布。",
      "incremental_strategy": "不做局部增量，先构建完整新包并通过质量报告。",
      "old_data_handling": "core 导入时以新完整包替换目标表；旧包保留 manifest 和快照元数据用于回滚。",
      "promotion_gate": "manifest_hash_ok_and_quality_report_ok"
    },
    "partition_replace": {
      "change_detection": "按 partition_keys 比较来源日期、内容 hash、行数和质量报告。",
      "incremental_strategy": "只替换本次分区，例如年份、批次、首选科目、城市或指标年份。",
      "old_data_handling": "未命中的旧分区保留；命中分区若存在差异先生成 reconciliation plan，删除必须走 delete plan。",
      "promotion_gate": "partition_quality_ok_and_reconciliation_ready"
    },
    "primary_key_upsert": {
      "change_detection": "按主键和 content_hash 识别新增、更新与无变化记录。",
      "incremental_strategy": "只发布已复核主键行，core 按主键插入或更新。",
      "old_data_handling": "冲突值进入复核；删除或排除已有 core 行必须单独生成 delete plan。",
      "promotion_gate": "reviewed_keys_and_package_quality_ok"
    },
    "append_snapshot": {
      "change_detection": "每次采集生成 snapshot_id，同一来源同一快照 hash 已存在时跳过。",
      "incremental_strategy": "只追加新快照，不覆盖历史快照。",
      "old_data_handling": "旧快照保留用于趋势、回测和来源追溯；过期只在输出层降权，不物理删除。",
      "promotion_gate": "snapshot_quality_ok"
    },
    "manual_review_promote": {
      "change_detection": "原始文件或网页证据按 raw_content_hash、source_url 和 source_date 去重。",
      "incremental_strategy": "raw/candidate/review 小步晋级，只发布 approved/verified/ready 行。",
      "old_data_handling": "候选与旧值冲突时生成 review plan；未复核行不得覆盖 core。",
      "promotion_gate": "manual_review_approved_and_lineage_complete"
    },
    "derived_rebuild": {
      "change_detection": "比较上游 package lineage、score_profile 和配置 hash。",
      "incremental_strategy": "从已发布标准表重建 mart；输入未变时跳过。",
      "old_data_handling": "旧 mart 以 snapshot 元数据保留；新 mart 失败时不替换上一次可用结果。",
      "promotion_gate": "input_lineage_and_reason_codes_ok"
    }
  },
  "nonstandard_policy": {
    "definition": "无稳定官方下载、字段经常变化、需要网页/OCR/人工判断或来自第三方页面的数据。",
    "stages": ["raw_snapshot", "parsed_candidate", "normalized_candidate", "review_batch", "approved_record", "published_package"],
    "required_lineage": ["source_title", "source_url", "evidence_quote", "source_date", "availability_date", "raw_content_hash"],
    "promotion_statuses": ["approved", "verified", "ready"],
    "blocked_statuses": ["todo", "needs_review", "needs_source_research", "rejected", "stale_source"],
    "old_data_policy": {
      "keep_raw_snapshots": true,
      "supersede_by_snapshot_date": true,
      "never_delete_without_delete_plan": true,
      "require_review_for_conflicting_values": true
    }
  },
