  "audit": {
    "pending_statuses": ["todo", "in_progress"],
    "complete_statuses": ["verified", "ready", "collected"],
    "blocked_statuses": ["blocked", "needs_source_research"],
    "required_signal_columns": ["occupation_code", "occupation_name", "metric_value", "source_title", "source_url", "evidence_quote", "source_date", "availability_date"],
    "required_catalog_columns": ["occupation_code", "occupation_name", "source_title", "source_url", "evidence_quote", "source_date", "availability_date"]
  },
  "review_batch": {
    "selection_statuses": ["todo", "in_progress"],
    "editable_columns": ["status", "metric_value", "metric_scope", "source_title", "source_url", "evidence_quote", "source_date", "availability_date", "reviewer", "reviewed_at", "notes"],
    "limit_per_source": 50,
    "sort": [
      {"field": "target_table", "type": "text", "direction": "asc"},
      {"field": "metric_value", "type": "number", "direction": "desc"},
      {"field": "occupation_name", "type": "text", "direction": "asc"},
      {"field": "occupation_code", "type": "text", "direction": "asc"},
      {"field": "metric_key", "type": "text", "direction": "asc"},
      {"field": "metric_year", "type": "number", "direction": "desc"},
      {"field": "city", "type": "text", "direction": "asc"}
    ]
  },
  "civil_service_signal_plan": {
    "source_key": "career_civil_service_posts",
    "target_table": "fa_fact_career_signal",
    "metric_key": "civil_service_post_count",
    "candidate_status": "in_progress",
    "default_city": "全国",
    "metric_value_field": "position_count",
    "max_evidence_positions": 5,
    "match_text_fields": ["major_requirement", "position_name", "position_description", "remarks"],
    "keyword_stopwords": ["工程", "技术", "人员", "职业", "岗位", "相关", "管理", "数据", "环境", "农业", "设计", "电子", "海洋"],
    "occupation_name_suffixes": ["工程技术人员", "技术人员", "工作人员", "人员", "工程师", "师"],
    "derived_keyword_terms": [
      "计算机", "软件", "数据科学", "大数据", "数据分析", "数据治理", "数据库", "网络安全", "信息安全", "信息通信", "地理信息", "通信",
      "电子商务", "电子数据", "电子信息", "电子技术",
      "会计", "财务", "审计", "法学", "法律",
      "测绘", "遥感", "地理", "地质", "气象", "海洋工程", "海洋测绘", "化工", "机械", "机器人", "物流", "供应链",
      "金融科技", "统计", "数学", "中文", "新闻", "传媒", "工业设计", "环境监测", "环境工程", "农业数字化", "数字农业"
    ]
  },
  "source_plan": {
    "sources": {
      "career_occupation_catalog": {
        "name": "职业分类与岗位标准",
        "kind": "official_catalog",
        "target_tables": ["fa_dim_career_occupation"],
        "official_distribution": "人社部、国家职业分类大典、国家职业标准公开目录",
        "collection_methods": ["download_remote_file", "parse_digital_occupation_catalog", "manual_pdf_table_review"],
        "evidence_urls": [
          "https://chinajob.mohrss.gov.cn/c/2022-10-28/363399.shtml"
        ],
        "metrics": [],
        "query_templates": [
          "国家职业分类大典 {metric_year} 职业代码",
          "国家职业标准 {entity_name} 职业"
        ],
        "notes": "用于建立专业到职业的中间层，不在 core 里手写岗位枚举。"
      },
      "career_recruitment_snapshot": {
        "name": "招聘需求与薪资快照",
        "kind": "controlled_market_snapshot",
        "target_tables": ["fa_fact_career_signal"],
        "official_distribution": "招聘平台公开聚合页、企业招聘页、第三方报告；遵守目标站点 ToS，优先人工导出或公开数据集",
        "collection_methods": ["manual_platform_export", "controlled_html_snapshot", "api_adapter_when_allowed"],
        "evidence_urls": [],
        "metrics": ["job_posting_count", "salary_median", "salary_p75", "work_intensity_index"],
        "query_templates": [
          "{entity_name} 招聘 薪资 {city} {metric_year}",
          "{entity_name} 岗位 JD 加班 强度 {city}"
        ],
        "notes": "不在本项目维护平台反爬绕过逻辑；只保留可复现、可引用、可人工复核的快照。"
      },
      "career_civil_service_posts": {
        "name": "公考与事业编岗位目录",
        "kind": "official_attachment",
        "target_tables": ["fa_fact_career_signal"],
        "official_distribution": "国考、省考、事业单位招录职位表",
        "collection_methods": ["download_remote_file", "parse_xlsx", "manual_review"],
        "evidence_urls": [
          "https://bm.scs.gov.cn/kl2026"
        ],
        "resource_api": {
          "page_url": "http://bm.scs.gov.cn/pp/gkweb/core/web/ui/business/download/gkdownloads.html",
          "api_url": "http://dl.scs.gov.cn/api/res/8a81f6d9980207bb0198ab5683670008/1110",
          "download_base_url": "http://dl.scs.gov.cn/download/",
          "source_date": "2025-10-14",
          "availability_date": "2025-10-14",
          "include_resource_keywords": ["考试录用公务员招考简章"],
          "exclude_resource_keywords": ["报名登记表", "报名推荐表", "面试人员名单", "进入面试人员名单", "调剂职位表", "补充录用"],
          "allowed_file_types": [".zip", ".xls", ".xlsx"],
          "headers": {
            "User-Agent": "Mozilla/5.0"
          }
        },
        "position_parser": {
          "header_row_index": 1,
          "required_columns": ["部门代码", "部门名称", "用人司局", "招考职位", "职位代码", "招考人数", "专业", "学历", "学位", "工作地点"],
          "column_map": {
            "department_code": "部门代码",
            "department_name": "部门名称",
            "bureau_name": "用人司局",
            "institution_type": "机构性质",
            "position_name": "招考职位",
            "position_attribute": "职位属性",
            "position_distribution": "职位分布",
            "position_description": "职位简介",
            "position_code": "职位代码",
            "institution_level": "机构层级",
            "exam_category": "考试类别",
            "recruit_count": "招考人数",
            "major_requirement": "专业",
            "education_requirement": "学历",
            "degree_requirement": "学位",
            "political_status": "政治面貌",
            "grassroots_years": "基层工作最低年限",
            "grassroots_project": "服务基层项目工作经历",
            "professional_test": "是否在面试阶段组织专业能力测试",
            "interview_ratio": "面试人员比例",
            "work_location": "工作地点",
            "settlement_location": "落户地点",
            "remarks": "备注",
            "department_website": "部门网站",
            "consult_phone_1": "咨询电话1",
            "consult_phone_2": "咨询电话2",
            "consult_phone_3": "咨询电话3"
          }
        },
        "metrics": ["civil_service_post_count", "public_sector_fit_score"],
        "query_templates": [
          "{entity_name} 国考 职位表 专业要求 {metric_year}",
          "{entity_name} 辽宁 事业单位 招聘 专业要求 {metric_year}"
        ],
        "notes": "用于判断专业的考公/编制岗位可见度，必须保留职位表来源和统计口径。"
      },
      "career_salary_survey": {
        "name": "职业薪酬调查",
        "kind": "official_or_report_metric",
        "target_tables": ["fa_fact_career_signal"],
        "official_distribution": "统计部门工资价位、行业薪酬报告、学校就业质量报告",
        "collection_methods": ["download_remote_file", "manual_report_metric"],
        "evidence_urls": [],
        "metrics": ["salary_median", "salary_p25", "salary_p75"],
        "query_templates": [
          "{entity_name} 薪酬 中位数 {metric_year}",
          "{entity_name} 就业质量报告 薪资 {metric_year}"
        ],
        "notes": "薪资必须注明城市、样本来源、税前税后口径。"
      }
    }
  },
  "metrics": {
    "job_posting_count": {
      "label": "招聘岗位数",
      "unit": "count",
      "min_value": 0,
      "score": {"component": "growth_score", "weight": 0.18, "method": "range", "min": 0, "max": 5000, "polarity": "positive"}
    },
    "salary_median": {
      "label": "月薪中位数",
      "unit": "cny_month",
      "min_value": 0,
      "score": {"component": "income_score", "weight": 0.24, "method": "range", "min": 3000, "max": 30000, "polarity": "positive"}
    },
    "salary_p25": {
      "label": "月薪25分位",
      "unit": "cny_month",
      "min_value": 0,
      "score": {"component": "stability_score", "weight": 0.08, "method": "range", "min": 2500, "max": 18000, "polarity": "positive"}
    },
    "salary_p75": {
      "label": "月薪75分位",
      "unit": "cny_month",
      "min_value": 0,
      "score": {"component": "income_score", "weight": 0.10, "method": "range", "min": 5000, "max": 50000, "polarity": "positive"}
    },
    "civil_service_post_count": {
      "label": "公考岗位数",
      "unit": "count",
      "min_value": 0,
      "score": {"component": "stability_score", "weight": 0.16, "method": "range", "min": 0, "max": 800, "polarity": "positive"}
    },
    "public_sector_fit_score": {
      "label": "体制内适配分",
      "unit": "score",
      "min_value": 0,
      "max_value": 100,
      "score": {"component": "stability_score", "weight": 0.12, "method": "range", "min": 0, "max": 100, "polarity": "positive"}
    },
    "work_intensity_index": {
      "label": "工作强度指数",
      "unit": "score",
      "min_value": 0,
      "max_value": 100,
      "score": {"component": "intensity_risk_score", "weight": 0.12, "method": "range", "min": 0, "max": 100, "polarity": "negative"}
    }
  },
  "score_profile": {
    "profile_id": "career_default_v1",
    "snapshot_date": "2026-05-13",
    "minimum_signal_count": 2,
    "output_table": "fa_mart_career_score",
    "friendly_35_components": ["income_score", "growth_score", "stability_score", "intensity_risk_score"]
  }
}
